{
  "name": "leadhunter-crm-server",
  "version": "1.0.0",
  "description": "LeadHunter CRM - B2B new-company lead generation backend",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node seed/migrate.js",
    "seed": "node seed/seed.js",
    "unseed": "node seed/seed.js --wipe-only",
    "setup": "node seed/migrate.js && node seed/seed.js",
    "test": "node seed/smoke-test.js",
    "test:monitoring": "node seed/monitoring-check.js",
    "test:export": "node --test tests/leadExport.test.js",
    "agent:ingest": "node scripts/agentIngest.js",
    "test:rbac": "node --test tests/rbac.test.js",
    "create-admin": "node scripts/createAdmin.js",
    "test:locations": "node --test tests/locations.test.js",
    "test:all": "node --test tests/"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "mysql2": "^3.11.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sqlite3": "^5.1.7"
  }
}
