# ---- Server ----
PORT=5000
NODE_ENV=development

# ================================================================
# DATABASE
# ----------------------------------------------------------------
# Option A — hosted Postgres (Supabase / Render / Neon):
#   set DATABASE_URL and leave the DB_* fields blank.
#   Use the "Session pooler" or direct connection string (port 5432),
#   NOT the transaction pooler (6543).
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# DB_SSL=true
#
# Option B — local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leadhunter
DB_USER=root
DB_PASSWORD=
# DB_DIALECT=mysql   # auto-detected: postgres if DATABASE_URL starts with postgres, else mysql
# ================================================================

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Development admin (seeded on `npm run seed`) ----
ADMIN_EMAIL=admin@leadhunter.local
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=LeadHunter Admin

# ---- Codefloor agent ingestion (optional) ----
# Used by `npm run agent:ingest` (scripts/agentIngest.js), the bridge the
# Codefloor AI OS (D:\CF\Claude, lead-research agent) uses to push discovered
# companies/signals into this CRM. Falls back to ADMIN_EMAIL/ADMIN_PASSWORD
# above if unset; set a dedicated account here to avoid sharing the admin login.
# CRM_AGENT_EMAIL=
# CRM_AGENT_PASSWORD=
# CRM_API_URL=http://localhost:5000/api

# ---- Apollo.io (optional — live company search + enrichment) ----
# Get a key at Apollo -> Settings -> Integrations -> API. Leave blank to disable.
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# ---- Contact enrichment (optional but needed for real email discovery) ----
# Get a free key at https://hunter.io (Sign up -> API -> API Key). Free plan:
# 25 domain searches + 50 verifications/month. Leave blank to disable enrichment
# (the pipeline still runs — it just won't look up emails).
HUNTER_API_KEY=

# ---- Automatic lead generation (optional) ----
# Business discovery is free by default (OpenStreetMap, no key needed).
# Set this to enable Google Places as a drop-in upgrade later:
GOOGLE_PLACES_API_KEY=
# Optional additional discovery source (Yelp Fusion API — https://www.yelp.com/developers).
# Leave blank to disable; OSM (and any other configured provider) keeps running on its own.
# Note: Yelp's API does not return a business's own website, only its Yelp profile page.
YELP_API_KEY=
# Shared secret an external cron service (cron-job.org, GitHub Actions) must send
# to POST /api/automation/run-scheduled. Required for reliable scheduling on a
# free Render instance that sleeps when idle. Generate any long random string.
AUTOMATION_TRIGGER_SECRET=

# ---- Enrichment cost control (optional — sane defaults if unset) ----
# Lead score (0-100) at/above which a company becomes eligible for contact
# enrichment (see server/services/enrichmentService.js#isEligibleForEnrichment).
ENRICHMENT_MIN_SCORE=50
# Days before a company that was already enriched can be re-enriched.
ENRICHMENT_REFRESH_DAYS=30

# ---- NVIDIA NIM / Nemotron (optional — AI qualification + outreach generation) ----
# OpenAI-compatible Chat Completions API (https://integrate.api.nvidia.com/v1). Get a
# key at https://build.nvidia.com (Get API Key on any NIM model page). Leave blank to
# disable — the pipeline runs exactly as it does today (rule-based qualification/outreach
# only); every AI step just marks itself "skipped" instead of failing anything.
# NEVER put a real key in this file — it is a template only.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Max wall-clock time (ms) to wait for one Nemotron response.
NVIDIA_TIMEOUT_MS=30000
# Retries on a transient (network/5xx/timeout/rate-limit) failure before marking failed.
NVIDIA_MAX_RETRIES=2
# When true, returns a canned fixture instead of calling NVIDIA — safe for local dev/tests
# without a configured key or spending real API credits.
NVIDIA_TEST_MODE=false

# ---- Hermes Agent research/enrichment (optional) ----
# Nous Research's Hermes Agent (https://github.com/NousResearch/Hermes-Agent), run
# locally as `hermes serve`, doing live public-web research per company (contacts,
# socials, business signals, opportunity angles) with sourced evidence. Leave
# HERMES_BASE_URL blank to disable — the pipeline runs exactly as it does today.
#
# Prerequisite (set in Hermes's OWN cli-config.yaml, not here):
#   platforms:
#     api_server:
#       enabled: true
#       extra:
#         key: "<a long random secret>"
# ...and launch `hermes serve` with a FIXED port (set API_SERVER_PORT, or the
# desktop app's launch command currently uses `--port 0` = random each start).
# Then put that fixed port + key below.
HERMES_BASE_URL=
HERMES_API_KEY=
# Max wall-clock time (ms) to wait for one research run to finish.
HERMES_TIMEOUT_MS=180000
# Max simultaneous Hermes research runs across manual + bulk requests.
HERMES_MAX_CONCURRENT=2
# Retries on a transient (network/5xx/timeout) failure before marking a run FAILED.
HERMES_MAX_RETRIES=2
# When true, returns a canned fixture instead of calling Hermes — safe for local
# dev/tests without a configured gateway or spending a real agent run.
HERMES_TEST_MODE=false

# ---- CORS ----
# Comma-separated list of allowed browser origins (your Vercel URL in production).
CLIENT_ORIGIN=http://localhost:5173
# Set true to also allow https://*.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=false
